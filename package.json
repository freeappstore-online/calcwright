{
  "name": "calcwright",
  "description": "Pro calculators for money and the trade: time value of money, loans, NPV/IRR and conduit bending. Offline and private.",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/calcwright.git"
  },
  "scripts": {
    "dev": "pnpm --filter @calcwright/web dev",
    "build": "pnpm --filter @calcwright/web build",
    "preview": "pnpm --filter @calcwright/web preview",
    "typecheck": "pnpm --filter @calcwright/web exec tsc -b",
    "test": "pnpm --filter @calcwright/web test",
    "test:e2e": "pnpm --filter @calcwright/web test:e2e"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
